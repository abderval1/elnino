<div class="container mt-4">
    <!-- Botão de voltar -->
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
            <form method="get" class="d-inline-block mb-2 mb-sm-0" action="/Diretorios/Ver">
                <input type="hidden" name="caminho" value="" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">⬅️ Voltar</button>
            </form>
    </div>

    <!-- Barra de filtros -->
    <div class="row align-items-center mb-3">
        <div class="col-md-6 mb-2 mb-md-0">
            <div class="form-inline">
                <label class="mr-2" style="font-size: 12px;">Ordenar por</label>
                <select class="form-control form-control-sm" style="font-size: 12px;">
                    <option>Nome</option>
                    <option>Data</option>
                    <option>Tamanho</option>
                </select>
            </div>
        </div>
        <div class="col-md-6">
            <form class="w-100 w-md-auto" method="get" action="/Diretorios/Ver">
